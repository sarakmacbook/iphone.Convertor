{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/vercel-build.mjs",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/convert.ts": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "node_modules/ffmpeg-static/{ffmpeg,package.json,index.js}"
    },
    "api/telegram/webhook.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/{ffmpeg,package.json,index.js}"
    },
    "api/cleanup.ts": {
      "maxDuration": 60,
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/config.ts": {
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/upload.ts": {
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/health.ts": {
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/telegram/login.ts": {
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/telegram/setup.ts": {
      "excludeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "17 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/telegram/login",
      "destination": "/api/telegram/login"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
