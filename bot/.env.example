# Copy this file to bot/.env and fill it in. Never commit the real .env.

# Required for the Telegram bot. Get it from @BotFather in Telegram (/newbot).
# If you only want the website's converter (no Telegram), leave it empty and
# set WEB_ONLY=true below.
TELEGRAM_BOT_TOKEN=

# Run the HTTP server only (health check, sign-in, and the website's conversion
# API) without connecting a Telegram bot.
# WEB_ONLY=false

# Largest video people can send, in MB. Telegram's hosted Bot API caps bot
# downloads at 20 MB, so 20 is the maximum unless you run your own Bot API server.
MAX_UPLOAD_MB=20

# Allow the "Custom dimensions" option, and its largest width/height in pixels.
ALLOW_CUSTOM=true
MAX_DIMENSION=3840

# How many videos to convert at the same time. Others wait in line.
MAX_CONCURRENT_JOBS=2

# Optional: path to ffmpeg. By default the bot uses ffmpeg-static if it
# installed, otherwise the "ffmpeg" on your PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: a self-hosted Bot API server (https://github.com/tdlib/telegram-bot-api),
# which raises the limits to 2000 MB. Run it with --local.
# TELEGRAM_API_ROOT=http://localhost:8081

# Optional: keep each successfully reduced output in a Telegram channel archive.
# Create a PRIVATE channel, add this bot as an administrator with permission to post,
# then set its numeric ID (usually starts with -100). The bot checks this on startup.
# Only the completed smaller copy is archived; original uploads stay temporary.
# TELEGRAM_ARCHIVE_CHAT_ID=-1001234567890
# Public channels are blocked by default. Set true only if you deliberately want
# archived user videos visible to the public.
TELEGRAM_ARCHIVE_ALLOW_PUBLIC=false

# Leave WEBHOOK_URL empty for long polling (simplest: works anywhere, even a laptop).
# Set it to your public HTTPS address to use a webhook instead.
# WEBHOOK_URL=https://your-bot.example.com
# WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_SECRET=any-long-random-string

# Port for the health check (and the webhook).
PORT=8080

# --- Website sign-in (Telegram Login Widget) ---------------------------------
# The website POSTs sign-in payloads to /telegram/login on this server.
# These settings control that endpoint.

# Which website origins may call /telegram/login: "*" for any (fine for a
# public site; the endpoint only verifies data the caller already has), or a
# comma-separated list of plain origins.
# CORS_ORIGIN=https://your-site.vercel.app,https://staging.example
CORS_ORIGIN=*

# How long a sign-in payload stays acceptable, in seconds (default 24 hours).
# LOGIN_MAX_AGE_SECONDS=86400

# Send a "you signed in on the website" message in Telegram after a verified
# sign-in. Needs the widget's write access (default) or that the person has
# started the bot; failures are silently ignored.
# LOGIN_GREETING=true

# --- Website converter (upload -> ffmpeg -> download) ------------------------
# The website's "Convert here" section uploads a gallery video to this server,
# which converts it with the same ffmpeg pipeline the Telegram bot uses.
#   GET    /api/config              presets and limits
#   POST   /api/convert             multipart upload, starts a job
#   GET    /api/jobs/:id            status, progress and real file sizes
#   GET    /api/jobs/:id/download   the converted MP4 (supports byte ranges)
#   DELETE /api/jobs/:id            cancel and delete

# Turn the conversion API off completely (keeps /health and /telegram/login).
# WEB_CONVERT=true

# Largest video the website may upload, in MB. This is a plain HTTP upload, so
# it is not limited by Telegram's 20 MB — only by your host's disk and patience.
# WEB_MAX_UPLOAD_MB=200

# How long a finished conversion stays downloadable before its files are
# deleted, in minutes.
# WEB_JOB_TTL_MINUTES=60

# Optional shared secret. When set, every /api request must send it as an
# "X-Api-Key" header (or ?key=... on downloads). The website can only supply it
# if you build it with VITE_BOT_API_KEY, which puts it in the public bundle —
# treat it as an abuse deterrent, not a secret.
# WEB_API_KEY=
